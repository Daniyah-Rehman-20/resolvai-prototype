# Copy to .env. Use a random URL-safe password (for example: openssl rand -hex 32).
POSTGRES_PASSWORD=replace-with-a-random-url-safe-password
NEXT_PUBLIC_API_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:3000
# Optional provider key enables recording transcription; never expose it as NEXT_PUBLIC_*.
VOICE_TRANSCRIPTION_API_KEY=
VOICE_TRANSCRIPTION_BASE_URL=https://api.openai.com/v1
VOICE_TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe
# Optional AI support replies; intake remains available when no key is configured.
SUPPORT_AI_API_KEY=
SUPPORT_AI_BASE_URL=https://api.openai.com/v1
SUPPORT_AI_MODEL=gpt-4.1-mini

# Private recording lifecycle; schedule the retention command in docs/OPERATIONS.md.
VOICE_MAX_UPLOAD_BYTES=10485760
VOICE_RETENTION_DAYS=7

# Optional Twilio incoming calls; see docs/OPERATIONS.md.
TELEPHONY_ENABLED=false
TELEPHONY_ACCOUNT_SID=
TELEPHONY_AUTH_TOKEN=
TELEPHONY_PUBLIC_BASE_URL=
TELEPHONY_PHONE_NUMBER=
